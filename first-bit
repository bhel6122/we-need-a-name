/* ---------------- router ---------------- */
function render(){
  const qp = new URLSearchParams(location.search);
  const md = qp.get('mode'); if(md) S.importMode = md;
  if(qp.get('demo') === 'done'){
    S.todayDone = true;
    const firstId = (GOAL_PATHS[S.goal] || [])[0];
    if(firstId && !S.done.includes(firstId)) S.done.push(firstId);
  }
  const as = qp.get('as');
  if(['admin','teacher','student'].includes(as)) S.role = as;
  const hash = (location.hash || '#/signin').replace('#/','');
  const name = hash.split('/')[0] || 'signin';
  /* only pages that belong to exactly one role force the role;
     course tools are shared by teacher and student, so they do not. */
  const ROLE_OF = {
