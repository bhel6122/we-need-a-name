        <button class="btn" onclick="closeModal()">Cancel</button>
        <button class="btn dark" onclick="doDelete()">Delete</button>
      </div>
    </div>`;
  document.body.appendChild(wrap);
}
function closeModal(){ const m = document.getElementById('modal'); if(m) m.remove(); pendingDelete = null; }
function doDelete(){
  if(pendingDelete){
    const {kind, idx} = pendingDelete;
    if(kind === 'course' && DATA.courses[idx]) DATA.courses.splice(idx,1);
    if(kind === 'user' && DATA.users[idx]) DATA.users.splice(idx,1);
    closeModal(); render(); toast(kind + ' deleted (soft delete)');
  } else { closeModal(); }
}

