<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Firstbit · Clickable Prototype</title>
<style>
  *{box-sizing:border-box;margin:0;padding:0}
  body{background:#dcdcdc;font-family:"Segoe UI",system-ui,-apple-system,"Microsoft YaHei",sans-serif;
       color:#2f2f2f;font-size:13px;padding:22px 0;line-height:1.45}
  .frame{width:1220px;margin:0 auto;background:#fff;border:1.5px solid #9b9b9b;border-radius:10px;
         display:flex;min-height:700px;overflow:hidden}

  /* ---------- sidebar (unified, per reference page) ---------- */
  .side{width:192px;flex:0 0 192px;border-right:1px solid #cfcfcf;padding:14px 12px 16px;
        display:flex;flex-direction:column;gap:9px;background:#fff}
  .role{background:#b5b5b5;color:#fff;text-align:center;padding:20px 8px;font-size:13px;letter-spacing:.4px}
  .nav{padding:9px 8px;background:#fbfbfb;border:1px solid #c9c9c9;font-size:12px;text-align:center;
       cursor:pointer;color:#454545;line-height:1.25;transition:.12s}
  .nav:hover{background:#f1f1f1}
  .nav.on{border:1.4px dashed #868686;background:#fff;font-weight:600;color:#222}
  .grp{font-size:9.5px;letter-spacing:1.2px;color:#9c9c9c;margin:7px 0 -1px 2px}
  .side .signout{margin-top:auto;font-size:11px;color:#7d7d7d;text-align:center;cursor:pointer;
                 padding:7px;border-top:1px solid #e6e6e6}
  .side .signout:hover{color:#333}

  /* ---------- main ---------- */
  .main{flex:1;display:flex;flex-direction:column;padding:12px 16px 16px;min-width:0}
  .topstrip{height:52px;border:1px solid #e0e0e0;display:flex;align-items:center;gap:10px;
            padding:0 12px;margin-bottom:10px;background:#fff}
  .spacer{flex:1}
  .rs{font-size:11.5px;padding:6px 12px;border:1px solid #cfcfcf;background:#fff;cursor:pointer;color:#666}
  .rs.on{background:#4a4a4a;border-color:#4a4a4a;color:#fff}
  .pagehead{display:flex;align-items:flex-end;gap:14px;margin:2px 0 12px}
  .pagehead h1{font-size:19px;font-weight:600;letter-spacing:.2px}
  .pagehead .sub{font-size:11.5px;color:#7a7a7a;margin-top:3px}
  .actions{margin-left:auto;display:flex;gap:8px;align-items:center}
  .content{flex:1;display:flex;flex-direction:column;gap:12px;min-height:0}
  .row{display:flex;gap:12px}
  .col{display:flex;flex-direction:column;gap:12px}

  /* ---------- atoms ---------- */
  .btn{font-size:12px;padding:8px 14px;border:1px solid #bdbdbd;background:#fff;color:#3d3d3d;
       cursor:pointer;line-height:1.2}
  .btn:hover{background:#f2f2f2}
  .btn.dark{background:#4a4a4a;border-color:#4a4a4a;color:#fff}
  .btn.dark:hover{background:#3a3a3a}
  .btn.ghost{border-color:transparent;background:transparent;color:#666;padding:6px 8px}
  .btn.ghost:hover{background:#f0f0f0}
  .btn.sm{font-size:11px;padding:5px 10px}
  .btn.dash{border:1.3px dashed #b0b0b0;background:#fff}
  .card{border:1px solid #d5d5d5;background:#fff}
  .card .hd{font-size:12px;font-weight:600;padding:9px 12px;border-bottom:1px solid #e6e6e6;color:#3a3a3a}
  .card .bd{padding:12px}
  .panel{background:#f4f4f4;border:1px solid #dcdcdc}
  .muted{color:#7c7c7c;font-size:11.5px}
  .tiny{font-size:10px;letter-spacing:.8px;color:#8d8d8d;text-transform:uppercase}
  .kpis{display:flex;border:1px solid #d5d5d5;background:#fafafa}
  .kpi{flex:1;text-align:center;padding:10px 6px;border-right:1px solid #e2e2e2}
  .kpi:last-child{border-right:0}
  .kpi .k{font-size:10.5px;color:#7a7a7a}
  .kpi .v{font-size:20px;font-weight:700;margin-top:3px;letter-spacing:.3px}
  .bar{height:9px;background:#ececec;position:relative;flex:1}
  .bar>i{position:absolute;left:0;top:0;bottom:0;background:#9c9c9c;display:block}
  table.tbl{width:100%;border-collapse:collapse;font-size:12px}
  table.tbl th{background:#c9c9c9;border:1px solid #b3b3b3;padding:8px 10px;text-align:left;
               font-weight:600;color:#2c2c2c}
  table.tbl td{border:1px solid #bfbfbf;padding:8px 10px;background:#fff}
  table.tbl tr:hover td{background:#fafafa}
  .link{color:#3d6ea5;cursor:pointer;text-decoration:underline;text-underline-offset:2px}
  .input,select.input,textarea.input{width:100%;padding:9px 10px;border:1px solid #cfcfcf;background:#fff;
       font-size:12px;font-family:inherit;color:#3a3a3a;outline:none}
  .input:focus{border-color:#8d8d8d}
  label.lbl{display:block;font-size:10px;letter-spacing:1px;color:#8a8a8a;margin-bottom:5px}
  .field{margin-bottom:13px}
  .chip{display:inline-block;padding:6px 12px;border:1px solid #c9c9c9;background:#fff;font-size:11.5px;
        color:#666;cursor:pointer;margin-right:6px}
  .chip.on{background:#4a4a4a;border-color:#4a4a4a;color:#fff}
  .drop{border:1.4px dashed #b6b6b6;background:#fcfcfc;padding:26px;text-align:center;color:#787878;
        cursor:pointer;font-size:12px}
  .drop:hover{background:#f6f6f6;border-color:#8f8f8f}
  .toast{position:fixed;left:50%;bottom:34px;transform:translateX(-50%);background:#3c3c3c;color:#fff;
         font-size:12px;padding:10px 18px;border-radius:3px;opacity:0;transition:.25s;pointer-events:none;z-index:99;
         max-width:680px;line-height:1.55;text-align:left}
  .toast.on{opacity:1}
  .modal-bg{position:fixed;inset:0;background:rgba(0,0,0,.28);display:flex;align-items:center;
            justify-content:center;z-index:80}
  .modal{background:#fff;border:1.5px solid #9b9b9b;width:420px;padding:22px}
  .modal h3{font-size:14px;margin-bottom:8px}
  .modal p{font-size:12px;color:#6f6f6f;margin-bottom:16px}

  /* ---------- auth ---------- */
  .auth{width:1220px;margin:0 auto;background:#fff;border:1.5px solid #9b9b9b;border-radius:10px;
        display:flex;min-height:620px;overflow:hidden}
  .auth .brand{width:320px;flex:0 0 320px;background:#f3f3f3;border-right:1px solid #e0e0e0;padding:34px 28px}
  .auth .brand h2{font-size:20px;font-weight:700;letter-spacing:.3px}
  .auth .brand p{font-size:11.5px;color:#707070;margin-top:10px;line-height:1.8}
  .auth .brand .slogan{font-size:12px;color:#4a4a4a;margin-top:7px;letter-spacing:.2px}
  .auth .brand .steps{margin-top:34px;font-size:11px;color:#666;line-height:2}
  .auth .form{flex:1;padding:42px 54px}
  .auth .form h1{font-size:22px;font-weight:600}
  .auth .form .lead{font-size:11.5px;color:#7c7c7c;margin:6px 0 20px}
  .auth .form .w{max-width:430px}
  .auth .form .foot{font-size:11.5px;color:#7c7c7c;margin-top:14px}
</style>
</head>
<body>
<div id="app"></div>
<div class="toast" id="toast"></div>
<script>
/* ============================================================
   Firstbit clickable prototype — no backend, no database.
   State lives in memory; navigating re-renders from DATA.
   ============================================================ */

const S = {
  role: 'admin',
  signedIn: false,
  course: 'Python Basics',
  me: {name:'Shelly Chen', email:'shelly.chen@connect.polyu.hk', sid:'24118877D', background:'Non-CS'},
  imported: false,
  published: false,
  enrolled: [0,1,4],
  tab: 'all',
  prior: [],
  done: [],
  aiGoal: '',
  aiNote: '',
  budget: 15,
  todayDone: false,
  streak: 5,
  goal: 'Ship a small tool'
};

const DATA = {
  students: [
    {name:'Shely', email:'shely@connect.polyu.hk', id:'S1024', course:'Python Basics', progress:100, status:'Completed', last:'Today'},
    {name:'Amy',   email:'amy@connect.polyu.hk',   id:'S1025', course:'Python Basics', progress:15,  status:'Falling behind', last:'1 day ago'},
    {name:'Tom',   email:'tom@connect.polyu.hk',   id:'S1026', course:'Data Structures', progress:62,  status:'In progress', last:'3 days ago'},
    {name:'Ken',   email:'ken@connect.polyu.hk',   id:'S1027', course:'AI Coding Basics', progress:78,  status:'In progress', last:'Yesterday'}
  ],
  modules: [
    {name:'Module 1 · Python basics', pct:100},
    {name:'Module 2 · Control flow', pct:100},
    {name:'Module 3 · Functions', pct:100},
    {name:'Module 4 · Data structures', pct:70},
    {name:'Module 5 · Files & errors', pct:0}
  ],
  activity: [
    {date:'October 16', module:'Module 4', pct:100},
    {date:'October 15', module:'Module 4', pct:100},
    {date:'October 13', module:'Module 3', pct:70}
  ],
  courses: [
    {name:'Python Basics', cat:'Programming', creator:'Professor. A', status:'Published'},
    {name:'Data Structures', cat:'Computer Science', creator:'Student. B', status:'Draft'},
    {name:'Web Fundamentals', cat:'Programming', creator:'Professor. A', status:'Published'},
    {name:'Machine Learning', cat:'Computer Science', creator:'Professor. C', status:'Draft'}
  ],
  users: [
    {name:'Shelly', email:'shely@connect.polyu.hk', role:'Professor', status:'Active'},
    {name:'Amy', email:'amy@connect.polyu.hk', role:'Student', status:'Inactive'},
    {name:'Tom', email:'tom@connect.polyu.hk', role:'Student', status:'Active'},
    {name:'Ken', email:'ken@connect.polyu.hk', role:'Student', status:'Active'}
  ],
  todos: [
    {title:'Requirement brief v1', course:'Python Basics', due:'2 days late', overdue:true},
    {title:'Peer review · 2 briefs', course:'Team & product skills', due:'Fri 23:59'},
    {title:'Module 6 quiz', course:'Python Basics', due:'Sun 23:59'},
    {title:'Mock interview', course:'Self-study', due:'in 9 days'}
  ],
  plan: ['Foundations','Control flow','Practice'],
  mine: [
    {name:'Module 1', meta:'2 / 12 modules'},
    {name:'Module 2', meta:'2 / 12 modules'},
    {name:'Module 3', meta:'2 / 12 modules'}
  ]
};

const NAVS = {
  /* admin: only the two management pages + profile */
  admin: [
    ['courses','Course Management'],
    ['users','User Management'],
    ['profile','Profile']
  ],
  teacher: [
    ['dashboard','Dashboard'],
    ['course-progress','Course Progress Overview'],
    ['students','Student Progress Overview'],
    ['profile','Profile'],
    ['--','COURSE TOOLS'],
    ['course-library','Course Library'],
    ['narration','AI Narration']
  ],
  student: [
    ['dashboard','Dashboard'],
    ['course','Course list'],
    ['map','Course map'],
    ['todo','To-do List'],
    ['plan','My path'],
    ['tutor','AI Tutor'],
    ['profile','Profile'],
    ['--','MY COURSE TOOLS'],
    ['course-library','Course Library']
  ]
};

/* ---------------- helpers ---------------- */
const cap = s => s.charAt(0).toUpperCase() + s.slice(1);
const go = r => { location.hash = '#/' + r; };
const esc = s => String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;');

function toast(msg){
  const t = document.getElementById('toast');
  t.textContent = msg; t.classList.add('on');
  clearTimeout(t._t); t._t = setTimeout(()=>t.classList.remove('on'), 1800);
}

function sidebar(active){
  let h = `<aside class="side"><div class="role">${S.role==='admin'?'Admin':(S.role==='teacher'?'Teacher':'Student')}</div>`;
  NAVS[S.role].forEach(([id,label])=>{
    if(id === '--'){ h += `<div class="grp">${label}</div>`; return; }
    h += `<div class="nav ${active===id?'on':''}" onclick="go('${id}')">${label}</div>`;
  });
  h += `<div class="signout" onclick="go('signin')">Sign out</div></aside>`;
  return h;
}

function shell(active, {title, sub='', actions='', body='', back=''}){
  return `<div class="frame">
    ${sidebar(active)}
    <main class="main">
      <div class="topstrip">
        ${back?`<button class="btn ghost" onclick="go('${back}')">← Back</button>`:`<span class="muted">${S.role==='admin'?'Platform':S.course}</span>`}
        <div class="spacer"></div>
        <span class="muted">${S.role==='admin'?'Admin console':(S.role==='teacher'?'Prof. Ada Wong':'Shelly Chen')} · ${S.role==='admin'?'Administrator':(S.role==='teacher'?'Instructor':'Student')}</span>
      </div>
      <div class="pagehead"><div><h1>${title}</h1>${sub?`<div class="sub">${sub}</div>`:''}</div>
        <div class="actions">${actions}</div></div>
      <div class="content">${body}</div>
    </main></div>`;
}

function setRole(r){ S.role = r; go('dashboard'); render(); }

function bar(pct, w='100%'){
  return `<div class="bar" style="width:${w}"><i style="width:${pct}%"></i></div>`;
}

function kpis(items){
  return `<div class="kpis">${items.map(([k,v])=>`<div class="kpi"><div class="k">${k}</div><div class="v">${v}</div></div>`).join('')}</div>`;
}

function table(headers, rows, cls=''){
  return `<table class="tbl ${cls}"><thead><tr>${headers.map(h=>`<th>${h}</th>`).join('')}</tr></thead>
    <tbody>${rows.map(r=>`<tr>${r.map(c=>`<td>${c}</td>`).join('')}</tr>`).join('')}</tbody></table>`;
}

/* ---------------- screens ---------------- */
const SCREENS = {};

/* ===== auth ===== */
SCREENS.signin = () => `<div class="auth">
  <div class="brand">
    <h2>Firstbit</h2>
    <div class="slogan">Every journey starts with a bit.</div>
    <p>Learn software engineering the way it is practised now — by directing, judging and correcting AI agents.</p>
    <div class="steps">
      <div>1 &nbsp; Your instructor imports the class list.</div>
      <div>2 &nbsp; You receive an invite link by email.</div>
      <div>3 &nbsp; Set a password and pick a background.</div>
    </div>
  </div>
  <div class="form"><div class="w">
    <h1>Sign in</h1>
    <div class="lead">Use the account your instructor set up, or create one.</div>

    <label class="lbl">I AM SIGNING IN AS</label>
    <div style="margin-bottom:20px" id="signinRole">
      ${[['student','Student'],['teacher','Instructor'],['admin','Administrator']].map(([k,l],i)=>
        `<span class="chip ${i===0?'on':''}" onclick="pick(this,'signinRole')" data-role="${k}">${l}</span>`).join('')}
    </div>

    <div class="field"><label class="lbl">EMAIL</label><input class="input" value="shelly.chen@connect.polyu.hk"></div>
    <div class="field"><label class="lbl">PASSWORD</label><input class="input" type="password" value="············"></div>
    <div class="row" style="align-items:center;margin-bottom:18px">
      <label style="font-size:11.5px;color:#6f6f6f"><input type="checkbox" checked> &nbsp;Keep me signed in</label>
      <div class="spacer"></div>
      <span class="link" onclick="go('reset')">Forgot password?</span>
    </div>
    <button class="btn dark" style="width:100%;padding:11px" onclick="signIn()">Sign in</button>
    <div class="foot" style="display:flex">
      <span>New here?</span><div class="spacer"></div>
      <span class="link" onclick="go('signup')">Create an account →</span>
    </div>
  </div></div>
</div>`;

function pick(el, groupId){
  [...document.getElementById(groupId).children].forEach(c=>c.classList.remove('on'));
  el.classList.add('on');
}

function signIn(){
  const box = document.getElementById('signinRole');
  const on = box.querySelector('.chip.on');
  S.role = on ? on.dataset.role : 'admin';
  S.signedIn = true;
  go(S.role === 'admin' ? 'courses' : 'dashboard');
  render();
}

SCREENS.signup = () => `<div class="auth">
  <div class="brand">
    <h2>Firstbit</h2>
    <div class="slogan">Every journey starts with a bit.</div>
    <p>Takes about a minute. University email required — it is how your instructor finds you in the class list.</p>
  </div>
  <div class="form"><div class="w">
    <h1>Create an account</h1>
    <div class="lead">Choose the role you are signing up as.</div>

    <label class="lbl">I AM A</label>
    <div style="margin-bottom:16px" id="signupRole">
      ${[['student','Student'],['teacher','Instructor'],['admin','Administrator']].map(([k,l],i)=>
        `<span class="chip ${i===0?'on':''}" onclick="pick(this,'signupRole')" data-role="${k}">${l}</span>`).join('')}
    </div>

    <div class="field"><label class="lbl">NAME</label><input class="input" placeholder="Alex Chan"></div>
    <div class="field"><label class="lbl">EMAIL</label><input class="input" placeholder="alex.chan@connect.polyu.hk"></div>
    <div class="row">
      <div class="field" style="flex:1"><label class="lbl">PASSWORD</label><input class="input" type="password"></div>
      <div class="field" style="flex:1"><label class="lbl">CONFIRM PASSWORD</label><input class="input" type="password"></div>
    </div>
    <div class="field"><label class="lbl">BACKGROUND</label>
      <div id="bg">
        <span class="chip on" onclick="pick(this,'bg')">CS</span>
        <span class="chip" onclick="pick(this,'bg')">Non-CS</span>
      </div>
    </div>
    <label style="font-size:11px;color:#6f6f6f;display:block;margin:6px 0 16px">
      <input type="checkbox"> &nbsp;I agree to the privacy statement, and to my instructor seeing my learning activity.
    </label>
    <button class="btn dark" style="width:100%;padding:11px" onclick="toast('Account created — please sign in');go('signin')">Create account</button>
    <div class="foot" style="display:flex">
      <span>Already have an account?</span><div class="spacer"></div>
      <span class="link" onclick="go('signin')">Sign in</span>
    </div>
  </div></div>
</div>`;

SCREENS.reset = () => `<div class="auth">
  <div class="brand">
    <h2>Firstbit</h2>
    <div class="slogan">Every journey starts with a bit.</div>
    <p>Enter the email on your account. The verification code expires in 30 minutes and can be used once.</p>
  </div>
  <div class="form"><div class="w">
    <h1>Reset your password</h1>
    <div class="lead">We send a code to your university email.</div>
    <div class="field"><label class="lbl">EMAIL</label>
      <div class="row"><input class="input" placeholder="shelly.chen@connect.polyu.hk">
        <button class="btn" style="white-space:nowrap" onclick="toast('Verification code sent')">Send code</button></div>
    </div>
    <div class="row">
      <div class="field" style="flex:1"><label class="lbl">PASSWORD</label><input class="input" type="password"></div>
      <div class="field" style="flex:1"><label class="lbl">CONFIRM PASSWORD</label><input class="input" type="password"></div>
    </div>
    <div class="field"><label class="lbl">VERIFICATION CODE</label><input class="input" placeholder="6 digits"></div>
    <label style="font-size:11px;color:#6f6f6f;display:block;margin:4px 0 16px">
      <input type="checkbox"> &nbsp;I agree to the privacy statement.
    </label>
    <button class="btn dark" style="width:100%;padding:11px" onclick="toast('Password reset — please sign in');go('signin')">Reset password</button>
    <div class="foot" style="margin-top:14px"><span class="link" onclick="go('signin')">← Back to sign in</span></div>
  </div></div>
</div>`;

/* ===== dashboard — three roles, three dashboards ===== */
SCREENS.dashboard = () => {
  if(S.role === 'teacher') return teacherDashboard();
  if(S.role === 'admin')   return adminDashboard();
  return studentDashboard();
};

/* ---- student: learning record + plan entry (slide 5) ---- */
function studentDashboard(){
  const bars = [26,40,34,62,48,76,88,52];
  return shell('dashboard', {
    title: 'Dashboard',
    sub: 'Learning record · modules finished, minutes this week, activity and to-dos',
    actions: `<button class="btn" onclick="toast('Report exported')">Export</button>`,
    body: `
      ${kpis([['MODULES FINISHED','22 / 26'],['MINUTES THIS WEEK','96'],['DAYS IN A ROW','4']])}
      <div class="row" style="flex:1;min-height:0">
        <div class="col" style="flex:1.15;min-width:0">
          <div class="card">
            <div class="hd" style="display:flex">YOUR COURSES <span class="spacer"></span>
              <span class="muted">${S.enrolled.length} enrolled</span>
              <span class="link" style="margin-left:10px" onclick="go('course')">All ›</span></div>
            <div class="bd col" style="gap:15px">
              ${S.enrolled.length === 0
                ? `<div class="muted" style="padding:8px 0">No courses yet — <span class="link" onclick="go('course')">browse the course list</span>.</div>`
                : S.enrolled.map(i=>{
                    const c = COURSE_POOL[i];
                    const done = Math.round(c.mods * c.pct / 100);
                    return `
                    <div>
                      <div style="display:flex;align-items:center;gap:10px">
                        <span class="link" style="font-size:12px;font-weight:600" onclick="watchCourse(${i})">${c.name}</span>
                        <span class="muted" style="font-size:11px">${c.type}</span>
                        <span class="spacer"></span>
                        <span class="muted">${done} / ${c.mods} modules · ${c.pct}%</span>
                      </div>
                      <div style="margin-top:6px">${bar(c.pct)}</div>
                    </div>`;
                  }).join('')}
            </div>
          </div>
          <div class="card" style="flex:1;display:flex;flex-direction:column">
            <div class="hd">ACTIVITY · LAST 8 WEEKS</div>
            <div class="bd" style="display:flex;align-items:flex-end;gap:14px;flex:1;min-height:180px">
              ${bars.map((h,i)=>`<div style="flex:1;text-align:center">
                <div style="height:${Math.round(h*1.7)}px;background:${i===6?'#5a5a5a':'#c9c9c9'};margin-bottom:5px"></div>
                <div class="tiny">W${i+1}</div></div>`).join('')}
            </div>
          </div>
        </div>

        <div class="col" style="width:330px;flex:0 0 330px">
          <div class="card">
            <div class="hd" style="display:flex">MY LEARNING PLAN <span class="spacer"></span>
              <span class="link" onclick="go('plan')">Open ›</span></div>
            <div class="bd">
              ${(() => {
                const st = pathSteps().find(x=>x.status==='now');
                const nx = pathSteps().find(x=>x.status==='next');
                if(S.todayDone) return `
                  <div class="tiny" style="color:#3f7f4f">DONE FOR TODAY</div>
                  <div style="font-size:12.5px;font-weight:600;margin-top:4px">${S.budget} min · streak ${S.streak + 1}</div>
