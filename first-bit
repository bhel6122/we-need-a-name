function aiGenerate(){
  const el = document.getElementById('aiGoal');
  const txt = (el && el.value ? el.value : '').trim();
  if(!txt){ toast('Describe what you want to be able to do first'); return; }
  const t = txt.toLowerCase();
  const before = pathSteps().length;
  let goal = 'Ship a small tool';
  if(/(exam|pass|grade|semester|course)/.test(t)) goal = 'Pass the course';
  else if(/(understand|curious|what is|explore|concept)/.test(t)) goal = 'Just explore';
  S.goal = goal; S.aiGoal = txt; S.done = [];
  const after = pathSteps().length;
  S.aiNote = 'Read \u201c' + txt + '\u201d \u2192 goal: ' + goal + '. '
    + after + ' steps' + (before ? ' (was ' + before + ')' : '') + '. '
    + 'Added Module 6 \u00b7 Testing because you said you will run it yourself; '
    + 'left out Module 5 \u00b7 Files and errors, which this goal does not need.';
  render();
  toast('Route drafted with AI \u2014 review it, then accept or regenerate');
}
function explainChanges(){
  if(!S.aiNote){ toast('Generate a route first'); return; }
  toast(S.aiNote);
}
function completeStep(id){
  if(!S.done.includes(id)) S.done.push(id);
  S.todayDone = true;
  S.streak = S.streak + 1;
  render();
  toast('Day done — ' + S.budget + ' minutes. The next step opens tomorrow.');
}
function whyStep(id){
  const m = COURSE_MAP.find(x=>x.id===id);
  toast(m.req.length ? 'Requires ' + m.req.map(r=>'Module '+r).join(' + ') + ' — that is why it sits here' : 'No prerequisites — it can start the path');
}

