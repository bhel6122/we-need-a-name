/* ===== student · my path (route built from the course map, one step at a time) ===== */
const MIN = {1:15, 2:18, 3:20, 4:25, 5:15, 6:20, 7:30};

function pathSteps(){
  const ids = (GOAL_PATHS[S.goal] || []).filter(id => !S.prior.includes(id));
  const firstOpen = ids.find(id => !S.done.includes(id));
  return ids.map(id => {
    const m = COURSE_MAP.find(x => x.id === id);
    return {
      id, name: m.name, min: MIN[id] || 20,
      status: S.done.includes(id) ? 'done'
            : (id === firstOpen && !S.todayDone ? 'now' : 'next')
    };
  });
}

SCREENS.plan = () => {
  const steps = pathSteps();
  const cur = steps.find(s => s.status === 'now');
  const total = steps.reduce((a, s) => a + s.min, 0);
  const skipped = S.prior.length;

  return shell('plan', {
    title: 'My path',
    sub: 'Built from the course map — then cut down by your goal, your background and what you tested out of.',
    back: 'dashboard',
    actions: `<button class="btn" onclick="go('map')">View course map</button>
              <button class="btn" onclick="genPlan()">Rebuild</button>`,
    body: `
      <div class="card" style="border-color:#E8C4BF;background:#FBF7F6">
        <div class="bd" style="display:flex;align-items:center;gap:18px">
          <div style="flex:1;min-width:0">
            <div class="tiny" style="color:#B03A2E">
              ${S.todayDone ? 'TODAY IS DONE · SEE YOU TOMORROW' : `DAY ${S.streak + 1} · ${S.budget}-MINUTE BUDGET`}
            </div>
            ${S.todayDone
              ? `<div style="font-size:19px;font-weight:600;margin-top:4px">${S.budget} of ${S.budget} minutes done</div>
                 <div class="muted" style="margin-top:4px">One step a day is the whole trick — the next one opens tomorrow, not now.</div>`
              : (cur
                ? `<div style="font-size:19px;font-weight:600;margin-top:4px">${cur.name}</div>
                   <div class="muted" style="margin-top:4px">
                     ${Math.min(cur.min, S.budget)} of ${cur.min} minutes today${cur.min > S.budget ? ' · part 1 of ' + Math.ceil(cur.min / S.budget) : ''} · nothing before it is required.
                   </div>`
                : `<div style="font-size:19px;font-weight:600;margin-top:4px">Path complete</div>
                   <div class="muted" style="margin-top:4px">Every step on this path is done. Pick a new goal, or test out of more modules.</div>`)}
          </div>
          ${S.todayDone
            ? `<div style="text-align:right">
